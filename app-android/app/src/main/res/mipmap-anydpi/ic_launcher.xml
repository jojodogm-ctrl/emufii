<?xml version="1.0" encoding="utf-8"?>
<!--
  The v2 logo is a wide drawing (two rings, ~1.86:1) sitting on white. So it is
  the *background* layer, the one the launcher masks, and the foreground layer is
  empty: there is nothing to float above it.

  It is scaled to 58 % of the frame's width, which is the largest rectangle of
  that ratio fitting entirely inside an adaptive icon's safe circle. No launcher
  mask, round or squircle, can therefore clip the rings. The price is a generous
  white margin; the full-frame version cut the ends off the wordmark.

  `monochrome` is the drawing's silhouette, for Android 13's themed icons, which
  is what the Thor uses. Without it the system keeps the icon in colour in the
  middle of a tinted home screen.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
