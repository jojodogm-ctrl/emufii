<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the persisted periodic notification job survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wi-Fi power saving drops packets; Switch LDN does not tolerate it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 16 refuses a job with a network constraint without it (FriendWatchJob). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="org.azahar_emu.azahar.debug" />
        <!-- Azahar still publishes under the identifier inherited from Lime3DS; see AzaharPackage. -->
        <package android:name="io.github.lime3ds.android" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="me.magnum.melonds" />
        <package android:name="me.magnum.melonds.debug" />
        <package android:name="me.magnum.melondualds" />
        <package android:name="me.magnum.melondualds.dev" />
        <package android:name="me.magnum.melondualds.emufii" />
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="dev.eden.eden_emulator.nightly" />
        <!-- "Eden Optimized" ships under this package name. -->
        <package android:name="com.miHoYo.Yuanshen" />
        <package android:name="com.miHoYo.Yuanshen.nightly" />
        <package android:name="dev.legacy.eden_emulator" />
        <package android:name="dev.eden.eden_emulator.emufii" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.dolphinemu.debug" />
        <!-- `xyz.aethersx2.android` (AetherSX2, no network) is deliberately not declared. -->
        <package android:name="com.armsx2" />
    </queries>

    <!-- Needed for `PredictiveBackHandler` progress below Android 16. -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".EmufiiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Emufii">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Emufii"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Netplay events from WatermelonDS Emufii Edition, forwarded as telemetry. -->
        <receiver
            android:name=".telemetry.NetplayEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="eu.emufii.netplay.EVENT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notify.FriendWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".wg.EmufiiWgService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Session VPN tunnel for remote multiplayer" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- DNS-only tunnel for DS online play, scoped to melonDS. -->
        <service
            android:name=".wfc.WfcDnsService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DNS redirection to a third-party WFC revival server" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>


        <service
            android:name=".azahar.AzaharNetplayService"
            android:exported="false"
            android:label="@string/netplay_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/azahar_netplay_service" />
        </service>
        <!-- Android 16 ignores orientation on large screens without this opt-out (honoured up to targetSdk 36). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
    </application>

</manifest>